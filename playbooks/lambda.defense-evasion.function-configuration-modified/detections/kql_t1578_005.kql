// Lambda function configuration modified (T1578.005)
//
// UpdateFunctionConfiguration changes twenty different things and the source rule rates them all
// P4 with no content check. Two of those fields — Handler and Layers — redirect execution WITHOUT
// modifying the deployment package, so CodeSha256 is unchanged and every code-integrity control
// still passes. This query separates them.
//
// `contains` throughout, never `has` — ARNs and handler strings are punctuated.
//
// Dialect: Sentinel / Azure Log Analytics KQL. NOT CloudWatch Logs Insights.
let LOOKBACK = 30d;
// POPULATE: the accounts whose Lambda layers are legitimately used here. A layer ARN embeds the
// owning account, and a cross-account layer is code you cannot read the contents of.
let OwnAccounts = dynamic(["111111111111", "222222222222"]);
AWSCloudTrail
| where TimeGenerated > ago(LOOKBACK)
| where EventSource == "lambda.amazonaws.com"
// CloudTrail appends a date and version to Lambda event names — UpdateFunctionConfiguration20150331v2
// is the documented form. Match by PREFIX, never by equality.
| where EventName startswith "UpdateFunctionConfiguration"
     or EventName startswith "UpdateFunctionCode"
     or EventName startswith "PublishVersion"
| where isempty(ErrorCode)
| extend Req = parse_json(RequestParameters)
| extend ReqText = tostring(RequestParameters)
| extend FunctionName = tostring(Req.functionName)
| extend HandlerChanged = ReqText contains '"handler"'
| extend LayersChanged = ReqText contains '"layers"'
| extend RoleChanged = ReqText contains '"role"'
| extend VpcChanged = ReqText contains '"vpcConfig"'
| extend KeyChanged = ReqText contains '"kmsKeyArn"'
// Environment VALUES are not available: AWS states the response element is "Omitted from AWS
// CloudTrail logs." Presence of the key is visible; contents are not, by design.
| extend EnvChanged = ReqText contains '"environment"'
| extend NewRole = tostring(Req.role)
| extend LayerArns = tostring(Req.layers)
// A layer ARN embeds the owning 12-digit account. Extract it to spot cross-account injection.
| extend LayerAccount = extract(@"arn:[a-zA-Z0-9-]+:lambda:[a-z0-9-]+:(\d{12}):layer:", 1, LayerArns)
| extend ForeignLayer = isnotempty(LayerAccount) and LayerAccount !in (OwnAccounts)
| summarize
    HandlerHijack = countif(HandlerChanged),
    LayerChanges  = countif(LayersChanged),
    ForeignLayers = countif(ForeignLayer),
    RoleChanges   = countif(RoleChanged),
    NetworkChanges= countif(VpcChanged),
    KeyChanges    = countif(KeyChanged),
    EnvChanges    = countif(EnvChanged),
    CodeChanges   = countif(EventName startswith "UpdateFunctionCode"),
    Functions     = make_set(FunctionName, 20),
    DistinctFuncs = dcount(FunctionName),
    NewRoles      = make_set_if(NewRole, isnotempty(NewRole), 5),
    LayerAccounts = make_set_if(LayerAccount, isnotempty(LayerAccount), 5),
    SourceIps     = make_set(SourceIpAddress, 5),
    FirstSeen     = min(TimeGenerated),
    LastSeen      = max(TimeGenerated)
    by UserIdentityArn, bin(TimeGenerated, 1h)
| where HandlerHijack > 0 or LayerChanges > 0 or RoleChanges > 0 or NetworkChanges > 0 or KeyChanges > 0
| extend Verdict = case(
    ForeignLayers > 0,
        strcat("LAYER FROM AN UNRECOGNISED ACCOUNT ATTACHED (", strcat_array(LayerAccounts, ","),
               ") — a layer is code that loads with the function, and its contents are not readable by the function owner, P0"),
    HandlerHijack > 0,
        "HANDLER REPOINTED — a different function inside the SAME package now runs. CodeSha256 is unchanged, so code signing and every package-hash baseline still pass, P0",
    DistinctFuncs >= 3,
        strcat("CONFIGURATION CHANGED ACROSS ", tostring(DistinctFuncs),
               " FUNCTIONS IN AN HOUR — a sweep rather than a tuning change, P0"),
    RoleChanges > 0,
        "EXECUTION ROLE CHANGED — the function's permissions changed with no IAM event, because no IAM object was modified. Compare the two roles, P1",
    LayerChanges > 0,
        "LAYER CHANGED — code added to the execution environment without touching the deployment package, P1",
    KeyChanges > 0,
        "KMS KEY CHANGED — this key encrypts the environment variables and SnapStart snapshots, so changing it changes who can read them, P1",
    NetworkChanges > 0,
        "VPC CONFIGURATION CHANGED — a function connected to a VPC reaches the internet only through it, so removing it returns the function to Lambda's own network where VPC egress controls do not apply, P2",
    "lambda configuration change")
| project FirstSeen, LastSeen, UserIdentityArn, Verdict, HandlerHijack, LayerChanges, ForeignLayers,
          RoleChanges, NetworkChanges, KeyChanges, EnvChanges, CodeChanges, DistinctFuncs,
          Functions, NewRoles, LayerAccounts, SourceIps
| order by ForeignLayers desc, HandlerHijack desc, DistinctFuncs desc
//
// ============================================================================
// THE CODE HASH IS THE WRONG BASELINE FOR THIS TECHNIQUE
// ============================================================================
// Handler and Layers change what executes without changing the package, so CodeSha256 stays
// constant. AWS returns a second hash for exactly this: `ConfigSha256`, alongside CodeSha256 on
// GetFunctionConfiguration. Baseline against it:
//   aws lambda get-function-configuration --function-name <name> \
//       --query '{code:CodeSha256, config:ConfigSha256, handler:Handler, role:Role, layers:Layers}'
// A drift check on CodeSha256 alone reports clean through every technique in this file.
//
// ============================================================================
// TWO THINGS THIS CANNOT SHOW
// ============================================================================
// ENVIRONMENT VARIABLE VALUES. AWS: the Environment response element is "Omitted from AWS CloudTrail
// logs." The EnvChanges column says the key was present; the contents are unavailable from the
// event and can only be read live, and only by a principal permitted to read them.
//
// WHETHER THE NEW ROLE IS MORE PERMISSIVE. The event carries the role ARN and nothing about its
// policies. Comparing the two roles is an IAM question — see
// ../../iam.privilege-escalation.admin-policy-attached/ for what "more permissive" means in practice.
