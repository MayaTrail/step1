{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyGrantOnAWSManagedEKSKey",
      "Effect": "Deny",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "eks.REGION.amazonaws.com"
        },
        "ForAnyValue:StringLike": {
          "kms:ResourceAliases": "alias/aws/eks"
        }
      }
    }
  ]
}
