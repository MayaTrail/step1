# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production

# Database (PostgreSQL). Read as individual variables, not as a DATABASE_URL
# string. docker-compose sets these for the db service; the defaults below match
# it, so leave them alone unless pointing at an external database such as RDS.
# prod.py requires POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD explicitly.
POSTGRES_DB=mayatrail
POSTGRES_USER=mayatrail
POSTGRES_PASSWORD=mayatrail
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Production only. dev.py allows every host and origin; prod.py reads both as
# comma-separated lists and ALLOWED_HOSTS has no default, so Django refuses
# every request until it is set.
#   ALLOWED_HOSTS=app.example.com,api.example.com
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# AWS credentials used for STS assume-role calls (platform-level).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Pulumi secrets passphrase — must match the value used when stacks were first created.
# Enterprise stacks: this encrypts stack config secrets in the S3 state backend.
# Changing this value after stacks exist will make existing state unreadable.
PULUMI_CONFIG_PASSPHRASE=

# Emulations package base directory.
# Each emulation's Pulumi program lives at {EMULATIONS_BASE_DIR}/{type}/infra/.
# Docker: set to the container path where emulations/ is mounted (e.g. /opt/emulations).
# Local dev: set to the absolute path of the step1/emulations/ directory.
EMULATIONS_BASE_DIR=

# Pause held between attack phases, in seconds, so fast emulations stay watchable
# in the live view during walkthroughs and demos. Leave empty or 0 for normal use
# so recorded run durations reflect real attack timing.
EMULATION_PHASE_PACING_SECONDS=0

# Guardrails package base directory.
# The SCP/RCP policy documents live at {GUARDRAILS_BASE_DIR}/policies/.
# Docker: set to the container path where guardrails/ is mounted (e.g. /opt/guardrails).
# Local dev: set to the absolute path of the step1/guardrails/ directory.
GUARDRAILS_BASE_DIR=

# Threat feed storage directory.
# Holds latest.json, the single document the daily ingest writes and the API
# reads back. The worker needs it writable; the backend only reads it.
# Docker: compose sets this to /var/lib/mayatrail/threatintel on a named volume.
# Local dev: any writable absolute path.
# Leave empty to disable ingestion; the endpoints then serve an empty feed.
THREATINTEL_DIR=

# Workflows. A workflow deploys an emulation, runs the attack, then waits for the
# customer's SIEM to post alerts to a signed webhook and scores what it caught.
#
# WORKFLOW_FERNET_KEY encrypts the per-endpoint HMAC secrets a SIEM signs with.
# REQUIRED for the alert webhook: with it empty the endpoints return 503 and no
# alert can be accepted, so a run scores every rule as not_integrated. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Separate from LLM_FERNET_KEY on purpose: the two secrets have different owners,
# and accepting alerts must not require the AI feature to be configured.
WORKFLOW_FERNET_KEY=

# How long a run keeps collecting alerts after its attack ends. SIEMs evaluate on
# a schedule, commonly every 5 to 15 minutes, so a window of seconds would score a
# working detection as silent. 30 spans two cycles for the slowest common cadence.
# Lower it only for demos: a short window makes slow detections look silent, and
# coverage history accumulates those verdicts into reliability figures.
WORKFLOW_ALERT_WAIT_MINUTES=30

# Share of runs a detection must fire in before coverage history treats it as
# dependable. Below 100 on purpose: a SIEM that evaluates on a schedule will
# occasionally report outside a run's window, and demanding every run would mark
# healthy detections as failing.
COVERAGE_TARGET_PCT=90

# Content roots. docker-compose mounts these read-only and sets them for you;
# set them only when running the backend outside Compose. An unset path means the
# matching library (emulations, playbooks, guardrails) discovers nothing.
#   EMULATIONS_BASE_DIR=/opt/emulations
PLAYBOOKS_BASE_DIR=

# Google OAuth — obtain from Google Cloud Console -> APIs & Services -> Credentials.
# Required for the "Continue with Google" login/signup flow.
# Leave empty to disable the Google OAuth button on the login page.
GOOGLE_CLIENT_ID=

# AI assistant — Fernet key encrypting stored LLM API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable AI key storage (the connector endpoints return 503).
LLM_FERNET_KEY=

# Email / SMTP. Delivers OTP codes for registration and password reset.
# When EMAIL_BACKEND is left as the console backend (the default), OTPs are only
# printed to the backend container logs and no real email is sent. For real
# delivery, switch EMAIL_BACKEND to the SMTP backend below and fill in the creds.
#   Gmail: keep EMAIL_HOST=smtp.gmail.com; EMAIL_HOST_PASSWORD must be a 16-char
#          App Password (needs 2-Step Verification), not the account password.
#   Amazon SES: EMAIL_HOST=email-smtp.<region>.amazonaws.com with SES SMTP creds.
# DEFAULT_FROM_EMAIL must be a sender the provider allows. For Gmail, use the same
# address as EMAIL_HOST_USER; for SES, use a verified identity.
# Note: env changes require recreating the backend container (up -d), not restart.
# OTP codes for registration and password reset, and the demo sandbox window.
# Defaults are sensible; set these only to tighten or relax them.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
DEMO_DURATION_MINUTES=60

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MayaTrail <noreply@mayatrail.tech>
