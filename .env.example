# Read by docker-compose itself (not by any container). Copy to .env.
# Application settings belong in backend/.env, not here.

# Shared secret between the worker and the scout container: Scout's scan
# service refuses any request without it. Any long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCOUT_SERVICE_TOKEN=

# Database connection for docker-compose-ec2.yaml, where Postgres runs on a
# separate instance. POSTGRES_HOST is that instance's private IP; the backend,
# worker and beat services read these. Not used by docker-compose.yml, which
# runs its own db service.
#
# This file is committed and public. Put NO real values here, not the host, not
# the db name, user, or password. All of them are required and read only from
# the untracked .env on the instance. Keep them as a set: whatever you set here
# must match how the Postgres container on the db instance was created.
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_PORT=5432   # optional, defaults to 5432 in the compose file

# Front-end edge port published by nginx (defaults to 80).
# HTTP_PORT=80

# Baked into the SPA at build time to enable "Continue with Google" (public,
# not a secret). Leave unset to fall back to frontend/UI/.env.
# VITE_GOOGLE_CLIENT_ID=
