# Read by docker-compose itself (not by any container). Copy to .env.
# Application settings belong in backend/.env, not here.

# Shared secret between the worker and the scout container: Scout's scan
# service refuses any request without it. Any long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCOUT_SERVICE_TOKEN=
