// CloudTrail trail logging stopped, and how long it stayed stopped (T1685.002)
//
// Every StopLogging (successful or refused) is a row. For each successful stop the query finds
// the first successful StartLogging on the same trail afterwards and reports the gap. A row with
// RestartTime empty means the trail is STILL STOPPED, or was restarted outside the lookback -
// check GetTrailStatus before deciding which.
//
// requestParameters.name may be the trail name or its ARN; TrailKey normalises both to the name
// (the last path segment of arn:aws:cloudtrail:<region>:<account>:trail/<name>) so a stop by ARN
// pairs with a start by name.
//
// Dialect: Sentinel / Azure Log Analytics KQL (AWSCloudTrail table).
let lookback = 7d;
let ct = AWSCloudTrail
    | where TimeGenerated > ago(lookback)
    | where EventSource == "cloudtrail.amazonaws.com"
    | where EventName in ("StopLogging", "StartLogging")
    | extend TrailParam = tostring(parse_json(RequestParameters).name)
    | extend TrailKey = tostring(split(TrailParam, "/")[-1]);
let starts = ct
    | where EventName == "StartLogging" and isempty(ErrorCode)
    | project StartTime = TimeGenerated, TrailKey, RecipientAccountId, AWSRegion,
              StartPrincipal = UserIdentityArn;
ct
| where EventName == "StopLogging"
| project StopTime = TimeGenerated, TrailKey, TrailParam, RecipientAccountId, AWSRegion,
          StopPrincipal = UserIdentityArn, AccessKey = UserIdentityAccessKeyId,
          StopError = ErrorCode, SourceIpAddress, UserAgent
| join kind=leftouter starts on TrailKey, RecipientAccountId, AWSRegion
| summarize RestartTime = minif(StartTime, StartTime > StopTime),
            StartPrincipal = take_anyif(StartPrincipal, StartTime > StopTime)
    by StopTime, TrailKey, TrailParam, RecipientAccountId, AWSRegion, StopPrincipal, AccessKey,
       StopError, SourceIpAddress, UserAgent
| extend Outcome = iff(isempty(StopError), "STOPPED", strcat("REFUSED: ", StopError)),
         GapMinutes = iff(isempty(StopError) and isnotnull(RestartTime),
                          datetime_diff("minute", RestartTime, StopTime), long(null)),
         SamePrincipalRestart = StopPrincipal == StartPrincipal
| order by StopTime desc
