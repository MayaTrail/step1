// FILE: kql_T1556_elb_createrule_auth_bypass.kql
// T1556 - Modify Authentication Process: ALB CreateRule Without Auth Action (Primary Signal)
//
// Detects CreateRule events on an ELBv2 listener where the injected rule's
// actions do NOT include authenticate-cognito or authenticate-oidc.
// An adversary with elasticloadbalancing:CreateRule can insert a priority-1
// http-header-conditioned rule that forwards matching requests directly to the
// protected backend, creating a selective authentication bypass backdoor.
//
// Platform: AWS CloudTrail -> Microsoft Sentinel (AWSCloudTrail table)
// High-fidelity query: CreateRule without any auth action is nearly always suspicious.

AWSCloudTrail
| where TimeGenerated >= ago(24h)
| where EventSource == "elasticloadbalancing.amazonaws.com"
| where EventName == "CreateRule"
| extend RequestParams = tostring(RequestParameters)
// Keep only rules whose action list omits both authenticate-cognito and authenticate-oidc
| where RequestParams !contains "authenticate-cognito"
      and RequestParams !contains "authenticate-oidc"
// Parse relevant fields from the JSON request blob
| extend
    ListenerArn = tostring(parse_json(RequestParameters).listenerArn),
    RulePriority = tostring(parse_json(RequestParameters).priority),
    RuleActions   = tostring(parse_json(RequestParameters).actions),
    RuleConditions = tostring(parse_json(RequestParameters).conditions),
    NewRuleArn    = tostring(parse_json(ResponseElements).rules[0].ruleArn)
| extend
    HasHttpHeaderCondition = RuleConditions contains "http-header",
    HasForwardAction       = RuleActions contains "forward",
    AlertTitle = "ALB CreateRule without authenticate-cognito - potential auth bypass"
| project
    TimeGenerated,
    AlertTitle,
    UserIdentityArn,
    UserIdentityPrincipalid,
    SourceIpAddress,
    UserAgent,
    AWSRegion,
    ListenerArn,
    RulePriority,
    HasHttpHeaderCondition,
    HasForwardAction,
    RuleConditions,
    RuleActions,
    NewRuleArn,
    ErrorCode,
    ErrorMessage
| sort by TimeGenerated desc

