// ======================================================================

// FILE: kql_T1556_elb_describe_burst.kql
// T1556 - Modify Authentication Process: ELB Describe* Reconnaissance Burst
//
// Detects a single IAM principal issuing multiple ELB Describe API calls
// (DescribeLoadBalancers, DescribeListeners, DescribeTargetGroups, DescribeRules)
// within a short window. Adversaries enumerate these resources to collect
// the ARNs needed to inject a backdoor listener rule.
//
// Platform: AWS CloudTrail -> Microsoft Sentinel (AWSCloudTrail table)
// Adjust lookback window (timeframe) to match your ELB change baseline.

let lookback = 30min;
let min_describe_variants = 3; // require at least 3 distinct Describe* calls
AWSCloudTrail
| where TimeGenerated >= ago(lookback)
| where EventSource == "elasticloadbalancing.amazonaws.com"
| where EventName in (
    "DescribeLoadBalancers",
    "DescribeListeners",
    "DescribeTargetGroups",
    "DescribeRules"
  )
| where UserIdentityArn !contains "AWSServiceRoleFor"
      and UserIdentityArn !contains "aws-elasticloadbalancing"
| summarize
    DescribeCallCount = count(),
    DistinctDescribeCalls = dcount(EventName),
    DescribeEventNames = make_set(EventName),
    SourceIPs = make_set(SourceIpAddress),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
  by UserIdentityArn, UserIdentityPrincipalid, AWSRegion
| where DistinctDescribeCalls >= min_describe_variants
| extend
    WindowMinutes = datetime_diff("minute", LastSeen, FirstSeen),
    AlertTitle = "ELB Describe* burst - possible pre-manipulation recon"
| project
    TimeGenerated = FirstSeen,
    AlertTitle,
    UserIdentityArn,
    UserIdentityPrincipalid,
    AWSRegion,
    DescribeCallCount,
    DistinctDescribeCalls,
    DescribeEventNames,
    SourceIPs,
    WindowMinutes,
    LastSeen
| sort by TimeGenerated desc
