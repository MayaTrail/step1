// Overwrite Lambda Function Code (T1525 / T1554)
//
// Two signals: a code overwrite by a non-deploy principal, and the
// download-then-overwrite sequence. GetFunction alone is excluded from
// alerting — a read is not tampering.
//
// CodeSha256 is the ground-truth field. responseElements.codeSha256 is the hash
// of what was just deployed; comparing it against the known-good build hash
// tells you the code actually changed and what it changed to.
//
// Dialect: Sentinel / Azure Log Analytics KQL. NOT CloudWatch Logs Insights.
AWSCloudTrail
| where TimeGenerated > ago(7d)
| where EventSource == "lambda.amazonaws.com"
| where EventName in ("UpdateFunctionCode", "GetFunction")
| where isempty(ErrorCode)
| extend Req  = parse_json(RequestParameters)
| extend Resp = parse_json(ResponseElements)
| extend FunctionName = tostring(coalesce(Req.functionName, Resp.functionName))
| extend NewSha256    = tostring(Resp.codeSha256)
| extend NewVersion   = tostring(Resp.version)
| summarize
    Overwrites  = countif(EventName == "UpdateFunctionCode"),
    Reads       = countif(EventName == "GetFunction"),
    NewHashes   = make_set_if(NewSha256, isnotempty(NewSha256), 5),
    Versions    = make_set_if(NewVersion, isnotempty(NewVersion), 5),
    Callers     = make_set(UserIdentityArn, 5),
    SourceIPs   = make_set(SourceIpAddress, 5),
    FirstSeen   = min(TimeGenerated),
    LastSeen    = max(TimeGenerated)
    by FunctionName, bin(TimeGenerated, 10m)
| where Overwrites > 0
| where not(Callers has "role/iac-deploy" or Callers has "role/ci-cd")   // tune allowlist
| extend Verdict = case(
    Reads > 0 and Overwrites > 0,
        "CODE DOWNLOADED THEN OVERWRITTEN — deliberate tampering, P0",
    "LAMBDA CODE OVERWRITTEN OUTSIDE PIPELINE — P0")
| project FirstSeen, LastSeen, FunctionName, Overwrites, Reads, NewHashes,
          Versions, Callers, SourceIPs, Verdict
| order by LastSeen desc
//
// ============================================================================
// THE DRIFT DETECTOR — deploy this alongside, it catches what the rule cannot
// ============================================================================
// The allowlist above exempts the deploy pipeline. If the PIPELINE ITSELF is
// compromised, this query stays silent. A CodeSha256 baseline check does not:
// compare each function's live hash against its known-good build hash on a
// schedule (Config custom rule or scheduled job).
//
// FIELD SHAPE — easy to get wrong, returns null if you do:
//   get-function-configuration  -> CodeSha256               (FLAT)
//   get-function                -> Configuration.CodeSha256 (NESTED)
// Use the shape matching the call you actually make.
//
// ROLLBACK: UpdateFunctionCode only changes $LATEST. Published numbered
// versions are IMMUTABLE, so a prior published version is a clean rollback
// target — repoint the alias to it rather than trying to reconstruct code.
//
// PREVENTION: Lambda code signing with
// UntrustedArtifactOnDeployment = Enforce rejects unsigned deployments outright.
//
// Invoke is data-plane; see the backdoor-function note for the sync-invoke trap
// when establishing whether the tampered code ran.
