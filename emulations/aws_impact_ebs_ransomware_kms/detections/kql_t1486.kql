// EBS Snapshot Re-encrypted Under External KMS Key (Ransomware Key-Swap)
// T1486 - Data Encrypted for Impact
// Flags CopySnapshot calls where the requestParameters contain a kmsKeyId ARN
// pointing to a key in a different account than the caller. This is the highest-fidelity
// signal for the EBS ransomware pattern -- attacker re-encrypts victim snapshots under
// their own CMK to seize control of the data.
//
// To narrow to cross-account key swaps, compare the account segment of kmsKeyId ARN
// against the account segment of userIdentity.arn using the extract() below.

AWSCloudTrail
| where EventName == "CopySnapshot"
| where EventSource == "ec2.amazonaws.com"
| where isnotempty(RequestParameters)
| extend kmsKeyId = tostring(parse_json(RequestParameters).kmsKeyId)
| where isnotempty(kmsKeyId) and kmsKeyId startswith "arn:aws:kms:"
// Extract account IDs for cross-account comparison
| extend callerAccount = tostring(split(UserIdentityArn, ":")[4])
| extend keyAccount   = tostring(split(kmsKeyId, ":")[4])
| extend isCrossAccountKey = (callerAccount != keyAccount and isnotempty(keyAccount))
| extend sourceSnapshotId = tostring(parse_json(RequestParameters).sourceSnapshotId)
| extend sourceRegion     = tostring(parse_json(RequestParameters).sourceRegion)
| project
    TimeGenerated,
    EventName,
    UserIdentityArn,
    UserIdentityType,
    SourceIpAddress,
    callerAccount,
    kmsKeyId,
    keyAccount,
    isCrossAccountKey,
    sourceSnapshotId,
    sourceRegion,
    AwsRegion
| sort by TimeGenerated desc

// ----- next query -----

// KMS Key Policy Modification Denied - Attempted Account Lockout
// T1486 - Data Encrypted for Impact
// Detects PutKeyPolicy calls that return AccessDenied. After re-encrypting victim data
// under an attacker CMK, the attacker may attempt to replace the key policy to revoke
// the account owner's administrative access to the key. A deny-guard fires and blocks
// the call, but CloudTrail still records the attempt with errorCode: AccessDenied.
//
// IMPORTANT: Do NOT add a filter for "no errorCode" -- the AccessDenied IS the signal.

AWSCloudTrail
| where EventName == "PutKeyPolicy"
| where EventSource == "kms.amazonaws.com"
| where ErrorCode == "AccessDenied"
| extend keyId      = tostring(parse_json(RequestParameters).keyId)
| extend policyName = tostring(parse_json(RequestParameters).policyName)
// Extract calling role/user name for correlation with prior ransomware events
| extend callerRole = tostring(split(UserIdentityArn, "/")[-1])
| project
    TimeGenerated,
    EventName,
    ErrorCode,
    ErrorMessage,
    UserIdentityArn,
    UserIdentityType,
    callerRole,
    SourceIpAddress,
    keyId,
    policyName,
    AwsRegion,
    UserAgent
| sort by TimeGenerated desc

// ----- next query -----

// EBS Ransomware Full Chain - Correlated Event Sequence
// T1486 - Data Encrypted for Impact
// Detects the complete EBS ransomware key-swap chain from a single principal within a
// 30-minute window: CreateSnapshot -> CopySnapshot (with kmsKeyId) -> DeleteVolume/
// DeleteSnapshot -> ScheduleKeyDeletion.
// Any principal triggering 3+ of these events in the window is flagged.
//
// Adjust the lookback window (30m) and minimum event count (3) to tune FP rate.

let LookbackWindow = 30m;
let MinChainEvents = 3;

let ransomware_events =
    AWSCloudTrail
    | where TimeGenerated > ago(LookbackWindow)
    | where EventSource in ("ec2.amazonaws.com", "kms.amazonaws.com")
    | where EventName in (
        "CreateSnapshot",
        "CopySnapshot",
        "DeleteVolume",
        "DeleteSnapshot",
        "ScheduleKeyDeletion",
        "CancelKeyDeletion"
    )
    | extend kmsKeyId = iff(
        EventName == "CopySnapshot",
        tostring(parse_json(RequestParameters).kmsKeyId),
        ""
    )
    | extend resourceId = case(
        EventName == "CreateSnapshot",    tostring(parse_json(RequestParameters).volumeId),
        EventName == "CopySnapshot",      tostring(parse_json(RequestParameters).sourceSnapshotId),
        EventName == "DeleteVolume",      tostring(parse_json(RequestParameters).volumeId),
        EventName == "DeleteSnapshot",    tostring(parse_json(RequestParameters).snapshotId),
        EventName == "ScheduleKeyDeletion", tostring(parse_json(RequestParameters).keyId),
        EventName == "CancelKeyDeletion", tostring(parse_json(RequestParameters).keyId),
        ""
    );

ransomware_events
| summarize
    EventCount         = count(),
    EventTypes         = make_set(EventName),
    FirstEvent         = min(TimeGenerated),
    LastEvent          = max(TimeGenerated),
    SourceIPs          = make_set(SourceIpAddress),
    AffectedResources  = make_set(resourceId),
    AttackerKmsKeys    = make_set(kmsKeyId),
    WindowMinutes      = datetime_diff("minute", max(TimeGenerated), min(TimeGenerated))
    by UserIdentityArn, AwsRegion
| where EventCount >= MinChainEvents
| extend HasKeySwap        = set_has_element(EventTypes, "CopySnapshot")
| extend HasDestruction    = (set_has_element(EventTypes, "DeleteVolume")
                              or set_has_element(EventTypes, "DeleteSnapshot"))
| extend HasRansomDemand   = set_has_element(EventTypes, "ScheduleKeyDeletion")
| extend ChainCompleteness = toint(HasKeySwap) + toint(HasDestruction) + toint(HasRansomDemand)
// Prioritize chains that have all three phases
| sort by ChainCompleteness desc, EventCount desc
| project
    FirstEvent,
    LastEvent,
    WindowMinutes,
    UserIdentityArn,
    AwsRegion,
    EventCount,
    ChainCompleteness,
    HasKeySwap,
    HasDestruction,
    HasRansomDemand,
    EventTypes,
    AttackerKmsKeys,
    AffectedResources,
    SourceIPs

// ----- next query -----

// KMS CMK Scheduled for Deletion After EBS Destruction - Ransom Demand Pattern
// T1486 - Data Encrypted for Impact
// Finds ScheduleKeyDeletion events preceded by DeleteVolume or DeleteSnapshot from the
// same principal within 10 minutes. The temporal correlation is the signal -- this is
// the ransomware "ransom demand" step: schedule the encryption key for deletion to
// create a deadline after which victim data is permanently unrecoverable.

let DestructionWindow = 10m;

let destruction_events =
    AWSCloudTrail
    | where TimeGenerated > ago(1h)
    | where EventSource == "ec2.amazonaws.com"
    | where EventName in ("DeleteVolume", "DeleteSnapshot")
    | project
        DestructionTime = TimeGenerated,
        DestructionEvent = EventName,
        DestructionPrincipal = UserIdentityArn,
        DestructionIP = SourceIpAddress,
        AwsRegion;

let key_deletion_events =
    AWSCloudTrail
    | where TimeGenerated > ago(1h)
    | where EventSource == "kms.amazonaws.com"
    | where EventName == "ScheduleKeyDeletion"
    | extend keyId = tostring(parse_json(RequestParameters).keyId)
    | extend pendingDays = toint(parse_json(RequestParameters).pendingWindowInDays)
    | project
        KeyDeletionTime = TimeGenerated,
        KeyDeletionPrincipal = UserIdentityArn,
        KeyDeletionIP = SourceIpAddress,
        keyId,
        pendingDays,
        AwsRegion;

key_deletion_events
| join kind=inner (destruction_events) on $left.KeyDeletionPrincipal == $right.DestructionPrincipal
| where KeyDeletionTime > DestructionTime
| where KeyDeletionTime <= DestructionTime + DestructionWindow
| project
    KeyDeletionTime,
    DestructionTime,
    KeyDeletionPrincipal,
    AwsRegion,
    keyId,
    pendingDays,
    DestructionEvent,
    DestructionIP,
    KeyDeletionIP
| sort by KeyDeletionTime desc
