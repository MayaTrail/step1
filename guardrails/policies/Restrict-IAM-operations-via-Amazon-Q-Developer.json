{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyIAMOperationsFromChat",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachUserPolicy",
        "iam:AttachRolePolicy",
        "iam:CreateAccessKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:CalledViaFirst": "chatbot.amazonaws.com"
        }
      }
    }
  ]
}
