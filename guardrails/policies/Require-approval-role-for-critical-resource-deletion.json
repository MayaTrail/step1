{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequireApprovalForTermination",
      "Effect": "Deny",
      "Action": [
        "ec2:TerminateInstances",
        "rds:DeleteDBInstance",
        "dynamodb:DeleteTable"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/ApprovedDestructionRole"
          ]
        }
      }
    }
  ]
}
